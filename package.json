{
	"name": "copy-selected-paths",
	"version": "1.0.0",
	"description": "Copy the absolute filesystem paths of one or more files selected in File Explorer.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"path",
		"file-explorer",
		"clipboard",
		"agents"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "22.20.1",
		"esbuild": "0.25.5",
		"obsidian": "1.13.1",
		"obsidian-typings": "6.34.0",
		"typescript": "5.9.3",
		"vitest": "3.2.7"
	}
}
